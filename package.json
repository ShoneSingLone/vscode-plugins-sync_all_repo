{
	"name": "x-space-toolkit",
	"displayName": "x-space Toolkit",
	"description": "x-space 一站式开发助手：多仓库同步、代码智能跳转、规范提交",
	"version": "1.0.0",
	"publisher": "ShoneSingLone",
	"engines": {
		"vscode": "^1.83.0"
	},
	"repository": {
		"url": "https://github.com/ShoneSingLone/sync_all_repo"
	},
	"categories": [
		"Other",
		"SCM Providers",
		"Snippets"
	],
	"activationEvents": [
		"onStartupFinished"
	],
	"main": "./out/extension.js",
	"contributes": {
		"viewsContainers": {
			"panel": [
				{
					"id": "shone-sing-lone-toolkit",
					"title": "x-space 工作台",
					"icon": "resources/icon.svg"
				}
			]
		},
		"views": {
			"shone-sing-lone-toolkit": [
				{
					"type": "webview",
					"id": "shone-sing-lone-toolkit-workbench",
					"name": "x-space 工作台"
				}
			]
		},
		"commands": [
			{
				"command": "shone.sing.lone.toolkit.refresh",
				"title": "x-space: 刷新仓库状态",
				"icon": "$(refresh)"
			},
			{
				"command": "shone.sing.lone.toolkit.syncAll",
				"title": "x-space: 全部同步",
				"icon": "$(sync)"
			},
			{
				"command": "shone.sing.lone.toolkit.pullAll",
				"title": "x-space: 全部拉取",
				"icon": "$(cloud-download)"
			},
			{
				"command": "shone.sing.lone.toolkit.syncCurrent",
				"title": "x-space: 同步当前仓库"
			},
			{
				"command": "shone.sing.lone.toolkit.pullCurrent",
				"title": "x-space: 拉取当前仓库"
			},
			{
				"command": "shone.sing.lone.toolkit.statusCurrent",
				"title": "x-space: 查看当前仓库状态"
			},
			{
				"command": "shone.sing.lone.toolkit.addRemote",
				"title": "x-space: 添加远程"
			},
			{
				"command": "shone.sing.lone.toolkit.manageRemotes",
				"title": "x-space: 管理远程"
			},
			{
				"command": "shone.sing.lone.toolkit.openTerminal",
				"title": "x-space: 打开仓库终端"
			},
			{
				"command": "shone.sing.lone.toolkit.revealInExplorer",
				"title": "x-space: 在资源管理器中显示仓库"
			},
			{
				"command": "shone.sing.lone.toolkit.rescanConfigs",
				"title": "x-space: 重新加载配置与函数索引"
			}
		],
		"menus": {
			"view/title": [
				{
					"command": "shone.sing.lone.toolkit.refresh",
					"when": "view == shone-sing-lone-toolkit-workbench",
					"group": "navigation@1"
				},
				{
					"command": "shone.sing.lone.toolkit.pullAll",
					"when": "view == shone-sing-lone-toolkit-workbench",
					"group": "navigation@2"
				},
				{
					"command": "shone.sing.lone.toolkit.syncAll",
					"when": "view == shone-sing-lone-toolkit-workbench",
					"group": "navigation@3"
				}
			]
		},
		"snippets": [
			{
				"language": "vue",
				"path": "./snippets/xUI.json"
			},
			{
				"language": "javascript",
				"path": "./snippets/xUI.json"
			},
			{
				"language": "typescript",
				"path": "./snippets/xUI.json"
			}
		]
	},
	"scripts": {
		"vscode:prepublish": "npm run compile",
		"compile": "tsc -p ./",
		"watch": "tsc -watch -p ./",
		"package": "vsce package"
	},
	"devDependencies": {
		"@types/node": "18.x",
		"@types/vscode": "^1.83.0",
		"typescript": "^5.0.0",
		"vsce": "^2.15.0"
	}
}
